# ---------------------------------------------------------

# PRODUCTS API - EXISTING SHOPPING APPLICATION

# ---------------------------------------------------------

@app.route("/api/products")

def get_products():

    connection = get_database_connection()

    try:

        products = connection.execute(

            """

            SELECT

                id,

                name,

                category,

                price,

                description,

                image,

                stock

            FROM products

            ORDER BY id

            """

        ).fetchall()

        product_list = []

        for product in products:

            product_list.append(

                {

                    "id": product["id"],

                    "name": product["name"],

                    "category": product["category"],

                    "price": product["price"],

                    "description": product["description"],

                    "image": product["image"],

                    "stock": product["stock"],

                }

            )

        return jsonify(product_list)

    finally:

        connection.close()

# ---------------------------------------------------------

# SIGN UP API - EXISTING SHOPPING APPLICATION

# ---------------------------------------------------------

@app.route("/api/signup", methods=["POST"])

def signup():

    data = request.get_json(silent=True)

    if not data:

        return jsonify(

            {

                "success": False,

                "message": "Invalid request",

            }

        ), 400

    username = (data.get("username") or "").strip()

    password = data.get("password") or ""

    if not username or not password:

        return jsonify(

            {

                "success": False,

                "message": "Username and password are required",

            }

        ), 400

    if len(username) < 3:

        return jsonify(

            {

                "success": False,

                "message": "Username must be at least 3 characters",

            }

        ), 400

    if len(password) < 6:

        return jsonify(

            {

                "success": False,

                "message": "Password must be at least 6 characters",

            }

        ), 400

    connection = get_database_connection()

    try:

        existing_user = connection.execute(

            "SELECT id FROM users WHERE username = ?",

            (username,),

        ).fetchone()

        if existing_user:

            return jsonify(

                {

                    "success": False,

                    "message": "Username already exists",

                }

            ), 409

        password_hash = generate_password_hash(password)

        connection.execute(

            """

            INSERT INTO users (username, password_hash)

            VALUES (?, ?)

            """,

            (username, password_hash),

        )

        connection.commit()

        return jsonify(

            {

                "success": True,

                "message": "Account created successfully",

            }

        ), 201

    finally:

        connection.close()

# ---------------------------------------------------------

# LOGIN API - EXISTING SHOPPING APPLICATION

# ---------------------------------------------------------

@app.route("/api/login", methods=["POST"])

def login():

    data = request.get_json(silent=True)

    if not data:

        return jsonify(

            {

                "success": False,

                "message": "Invalid request",

            }

        ), 400

    username = (data.get("username") or "").strip()

    password = data.get("password") or ""

    connection = get_database_connection()

    try:

        user = connection.execute(

            """

            SELECT id, username, password_hash

            FROM users

            WHERE username = ?

            """,

            (username,),

        ).fetchone()

    finally:

        connection.close()

    if user and check_password_hash(

        user["password_hash"],

        password,

    ):

        return jsonify(

            {

                "success": True,

                "username": user["username"],

            }

        )

    return jsonify(

        {

            "success": False,

            "message": "Invalid username or password",

        }

    ), 401

# ---------------------------------------------------------

# ADMIN LOGIN API - SEPARATE admin.db

# ---------------------------------------------------------

@app.route("/admin/login", methods=["POST"])

def admin_login():

    data = request.get_json(silent=True)

    if not data:

        return jsonify(

            {

                "success": False,

                "message": "Invalid request",

            }

        ), 400

    username = (data.get("username") or "").strip()

    password = data.get("password") or ""

    if not username or not password:

        return jsonify(

            {

                "success": False,

                "message": "Admin username and password are required.",

            }

        ), 400

    if not ADMIN_DATABASE.is_file():

        app.logger.error(

            "Admin database was not found: %s",

            ADMIN_DATABASE,

        )

        return jsonify(

            {

                "success": False,

                "message": "Admin database is not initialized.",

            }

        ), 503

    connection = get_admin_database_connection()

    try:

        admin = connection.execute(

            """

            SELECT id, username, password_hash

            FROM admins

            WHERE username = ?

            """,

            (username,),

        ).fetchone()

    except sqlite3.OperationalError:

        app.logger.exception(

            "Admin database schema is unavailable."

        )

        return jsonify(

            {

                "success": False,

                "message": "Admin database is not initialized correctly.",

            }

        ), 503

    finally:

        connection.close()

    if not admin or not check_password_hash(

        admin["password_hash"],

        password,

    ):

        return jsonify(

            {

                "success": False,

                "message": "Invalid admin username or password.",

            }

        ), 401

    session.clear()

    session["admin_id"] = admin["id"]

    session["admin_username"] = admin["username"]

    return jsonify(

        {

            "success": True,

            "message": "Admin login successful.",

            "username": admin["username"],

        }

    )

# ---------------------------------------------------------

# ADMIN LOGOUT API

# ---------------------------------------------------------

@app.route("/admin/logout", methods=["POST"])

def admin_logout():

    session.clear()

    return jsonify(

        {

            "success": True,

            "message": "Admin logged out successfully.",

        }

    )

# ---------------------------------------------------------

# ADMIN DASHBOARD SUMMARY API

# ---------------------------------------------------------

@app.route("/admin/api/summary", methods=["GET"])

def admin_dashboard_summary():

    authentication_error = admin_required_response()

    if authentication_error:

        return authentication_error

    runs = get_all_runs()

    latest_run = runs[0] if runs else None

    if latest_run:

        total = latest_run["total"]

        passed = latest_run["passed"]

        failed = latest_run["failed"]

        errors = latest_run["errors"]

        healing = latest_run["healing"]

        accepted = latest_run["accepted"]

        rejected = latest_run["rejected"]

        failed_healing = latest_run["failed_healing"]

        total_events = latest_run["total_events"]

    else:

        total = passed = failed = errors = 0

        healing = accepted = rejected = failed_healing = total_events = 0

    active_status = get_active_test_status()

    return jsonify(

        {

            "success": True,

            "total": total,

            "passed": passed,

            "failed": failed,

            "errors": errors,

            "healing": healing,

            "suggestions": healing,

            "accepted": accepted,

            "rejected": rejected,

            "failed_healing": failed_healing,

            "total_events": total_events,

            "total_tests": total,

            "passed_tests": passed,

            "failed_tests": failed,

            "test_errors": errors,

            "healing_suggestions": healing,

            "latest_run": latest_run,

            "is_running": active_status["running"],

            "active_process_id": active_status["pid"],

            "run_count": len(runs),

        }

    )

